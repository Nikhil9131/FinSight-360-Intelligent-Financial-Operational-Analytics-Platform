# FinSight 360 - Environment Configuration
# Copy this file to .env and update with your actual credentials
# NEVER commit .env to version control

# ─── PostgreSQL Database ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finsight360
DB_USER=finsight_user
DB_PASSWORD=finsight_secure_2024

# ─── Application Settings ─────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── Directory Paths ──────────────────────────────────────────
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SYNTHETIC_DIR=./data/synthetic
DATA_EXTERNAL_DIR=./data/external
LOG_DIR=./logs
REPORT_OUTPUT_DIR=./excel/reports
PDF_OUTPUT_DIR=./excel/reports
